/* cap input rows for the captured run */
options obs=100;
options validvarname=upcase;
/* sample SDTM inputs standing in for the study data the script reads from its rawdata library */
libname rawdata ".";
libname anadata ".";
libname original ".";
data rawdata.dm;
  length STUDYID $20 USUBJID $20 SUBJID $20 SITEID $20 SEX $1 AGEU $15 RACE $50 RFSTDTC $10 RFENDTC $10 COUNTRY $8 ARM $50 ARMCD $20;
  input USUBJID $ SUBJID $ SITEID $ AGE SEX $ COUNTRY $ RFSTDTC $ RFENDTC $ ARMCD $ ARM & $20.;
  STUDYID="CYT001"; AGEU="YEARS"; RACE="WHITE";
  datalines;
S001 001 101 54 M USA 2015-01-10 2015-06-10 PLAC PLACEBO
S002 002 101 61 F CAN 2015-01-12 2015-07-01 CYT3 CYT001 3 MG
S003 003 102 47 F DEU 2015-02-01 . CYT10 CYT001 10 MG
S004 004 103 70 M ZAF 2015-02-15 2015-08-20 PLAC PLACEBO
S005 005 103 38 F CHN 2015-03-03 2015-09-09 CYT3 CYT001 3 MG
S006 006 104 59 M POL 2015-03-20 . CYT10 CYT001 10 MG
;
run;
data rawdata.ds;
  length USUBJID $20 DSTERM $50 DSDECOD $50 DSCAT $50 DSSCAT $50 DSSTDTC $10;
  infile datalines dlm='|' dsd;
  input USUBJID $ DSTERM $ DSDECOD $ DSCAT $ DSSCAT $ DSSTDTC $;
  datalines;
S001|RANDOMIZED|RANDOMIZED|PROTOCOL MILESTONE|RANDOMIZATION|2015-01-09
S002|RANDOMIZED|RANDOMIZED|PROTOCOL MILESTONE|RANDOMIZATION|2015-01-11
S003|RANDOMIZED|RANDOMIZED|PROTOCOL MILESTONE|RANDOMIZATION|2015-01-30
S004|DEATH|DEATH|DISPOSITION EVENT|END OF STUDY|2015-08-01
S005|COMPLETED|COMPLETED|DISPOSITION EVENT|END OF STUDY|2015-09-09
S006|WITHDRAWAL BY SUBJECT|WITHDRAWAL BY SUBJECT|DISPOSITION EVENT|END OF STUDY|2015-07-15
;
run;
data rawdata.ex;
  length USUBJID $20 EXTRT $50 EXSTDTC $10 EXENDTC $10;
  infile datalines dlm='|' dsd;
  input USUBJID $ EXTRT $ EXSTDTC $ EXENDTC $;
  datalines;
S001|PLACEBO|2015-01-10|2015-03-10
S001|PLACEBO|2015-03-11|2015-06-10
S002|CYT001 3 MG|2015-01-12|2015-07-01
S003|CYT001 10 MG|2015-02-01|2015-04-01
S003|CYT001 10 MG|2015-04-02|2015-05-30
S004|PLACEBO|2015-02-15|2015-08-20
S005|CYT001 3 MG|2015-03-03|2015-09-09
S006|CYT001 10 MG|2015-03-20|2015-07-10
;
run;
data rawdata.vs;
  length USUBJID $20 VSTESTCD $8 VSBLFL $1;
  input USUBJID $ VSTESTCD $ VSSTRESN VSBLFL $;
  datalines;
S001 WEIGHT 80.5 Y
S001 HEIGHT 178 Y
S001 WEIGHT 79.0 N
S002 WEIGHT 62.3 Y
S002 HEIGHT 165 Y
S003 WEIGHT 70.1 Y
S003 HEIGHT 170 Y
S004 WEIGHT 88.0 Y
S004 HEIGHT 180 Y
S005 WEIGHT 55.2 Y
S005 HEIGHT 160 Y
S006 WEIGHT 90.4 Y
S006 HEIGHT 185 Y
;
run;
data rawdata.sv;
  length USUBJID $20 SVSTDTC $10;
  input USUBJID $ SVSTDTC $;
  datalines;
S001 2015-01-05
S001 2015-01-10
S002 2015-01-07
S003 2015-01-25
S004 2015-02-10
S005 2015-02-27
S006 2015-03-15
;
run;
/* previously developed ADSL that QC_adsl is compared against */
data original.adsl;
  length STUDYID $20 USUBJID $20 AGE 8 SEXN 8;
  input USUBJID $ AGE SEXN;
  STUDYID="CYT001";
  datalines;
S001 54 1
S002 61 2
S003 47 2
S004 70 1
S005 38 2
S006 59 1
;
run;
